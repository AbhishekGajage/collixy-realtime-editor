# ============================================
# 🚀 COLLIXY BACKEND - ENVIRONMENT TEMPLATE
# ============================================
# COPY THIS FILE TO .env AND FILL IN YOUR VALUES
# NEVER COMMIT .env TO GIT!
# ============================================

# ========================
# 🏃 SERVER CONFIGURATION
# ========================
PORT=5000
NODE_ENV=development
HOST=localhost

# ========================
# 🗄️ DATABASE (MongoDB Atlas)
# ========================
# Get this from MongoDB Atlas Dashboard
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/collixy?retryWrites=true&w=majority

# ========================
# 🔐 JWT AUTHENTICATION
# ========================
# Generate a strong secret: openssl rand -hex 32
JWT_SECRET=your_super_strong_jwt_secret_key_here_change_this
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your_refresh_token_secret_here
JWT_REFRESH_EXPIRE=30d

# ========================
# 🔑 GOOGLE OAUTH (For "Sign in with Google")
# ========================
# Create at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ========================
# 📧 EMAIL CONFIGURATION
# ========================
# For email authentication from your Figma design
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
# Use App Password, not regular password: https://myaccount.google.com/apppasswords
EMAIL_PASSWORD=your_16_digit_app_password_here
EMAIL_FROM=noreply@collixy.com

# ========================
# 🔄 REDIS (Optional - for real-time features)
# ========================
REDIS_URL=redis://localhost:6379
# REDIS_URL=redis://:password@host:port (for cloud Redis)

# ========================
# 🌐 CLIENT CONFIGURATION
# ========================
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ========================
# ⚡ SOCKET.IO
# ========================
SOCKET_PING_TIMEOUT=60000
SOCKET_PING_INTERVAL=25000

# ========================
# 📊 RATE LIMITING
# ========================
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# ========================
# 🎯 APPLICATION SETTINGS
# ========================
MAX_ROOM_SIZE=20
MAX_FILE_SIZE_MB=10
DEFAULT_LANGUAGE=javascript
SUPPORTED_LANGUAGES=javascript,typescript,python,java,cpp,go,rust,php,ruby

# ========================
# 🧪 DEVELOPMENT FLAGS
# ========================
# Set to false in production
SKIP_EMAIL_VERIFICATION=true
ENABLE_SWAGGER=true
DEBUG_MODE=true

# ============================================
# ⚠️ SECURITY REMINDER
# ============================================
# 1. Generate strong secrets
# 2. Use different values for development/production
# 3. Never commit actual .env files
# 4. Rotate secrets regularly
# ============================================