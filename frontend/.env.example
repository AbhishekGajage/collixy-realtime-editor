# ============================================
# 🎨 COLLIXY FRONTEND - ENVIRONMENT TEMPLATE
# ============================================
# COPY THIS FILE TO .env AND FILL IN YOUR VALUES
# ============================================

# ========================
# 🌐 API & SERVER CONFIG
# ========================
# Backend API URL
VITE_API_URL=http://localhost:5000/api
# WebSocket/Socket.IO URL
VITE_SOCKET_URL=http://localhost:5000
# Full backend URL
VITE_BACKEND_URL=http://localhost:5000

# ========================
# 🔐 AUTHENTICATION
# ========================
# Google OAuth Client ID (same as backend)
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
# Redirect URI for Google OAuth
VITE_GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback

# ========================
# 🏷️ APPLICATION INFO
# ========================
VITE_APP_NAME=COLLIXY
VITE_APP_TAGLINE=Code Together
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=Real-time Collaborative Code Editor

# ========================
# 🎨 EDITOR CONFIGURATION
# ========================
# Monaco Editor theme (vs, vs-dark, hc-black)
VITE_EDITOR_THEME=vs-dark
# Editor font size
VITE_EDITOR_FONT_SIZE=14
# Tab size in spaces
VITE_EDITOR_TAB_SIZE=2
# Show minimap (true/false)
VITE_EDITOR_MINIMAP=true
# Enable word wrap
VITE_EDITOR_WORD_WRAP=on
# Show line numbers
VITE_EDITOR_LINE_NUMBERS=on

# ========================
# 🎨 UI/UX SETTINGS
# ========================
# Primary color (blue)
VITE_PRIMARY_COLOR=#2563eb
# Secondary color (purple)
VITE_SECONDARY_COLOR=#7c3aed
# Default dark mode
VITE_DARK_MODE=true
# Default font family
VITE_FONT_FAMILY=Inter, system-ui, -apple-system, sans-serif

# ========================
# ⚡ PERFORMANCE
# ========================
# Auto-save interval in milliseconds
VITE_AUTO_SAVE_INTERVAL=3000
# Code change debounce delay
VITE_DEBOUNCE_DELAY=500
# Maximum file size in bytes (10MB)
VITE_MAX_FILE_SIZE=10485760
# Enable code compilation
VITE_ENABLE_CODE_EXECUTION=true

# ========================
# 🔧 FEATURE TOGGLES
# ========================
# Enable authentication methods
VITE_ENABLE_GOOGLE_AUTH=true
VITE_ENABLE_EMAIL_AUTH=true
VITE_ENABLE_GUEST_MODE=true

# Enable collaboration features
VITE_ENABLE_VOICE_CHAT=false
VITE_ENABLE_VIDEO_CHAT=false
VITE_ENABLE_SCREEN_SHARE=false

# Editor features
VITE_ENABLE_CODE_COMPLETION=true
VITE_ENABLE_SYNTAX_HIGHLIGHTING=true
VITE_ENABLE_ERROR_CHECKING=true

# ========================
# 📊 ANALYTICS & MONITORING
# ========================
# Google Analytics ID (optional)
VITE_GA_TRACKING_ID=G-XXXXXXXXXX
# Sentry DSN for error tracking (optional)
VITE_SENTRY_DSN=
# LogRocket ID (optional)
VITE_LOGROCKET_ID=

# ========================
# 🧪 DEVELOPMENT SETTINGS
# ========================
# Enable debug mode
VITE_DEBUG_MODE=true
# Log level (error, warn, info, debug)
VITE_LOG_LEVEL=debug
# Enable mock API for testing
VITE_ENABLE_MOCK_API=false
# Mock API delay in ms
VITE_MOCK_DELAY=500

# ========================
# 📱 PWA CONFIGURATION
# ========================
VITE_PWA_ENABLED=false
VITE_PWA_NAME=Collixy
VITE_PWA_SHORT_NAME=Collixy
VITE_PWA_THEME_COLOR=#2563eb
VITE_PWA_BACKGROUND_COLOR=#0f172a

# ============================================
# 🚀 QUICK START INSTRUCTIONS
# ============================================
# 1. Copy this file to .env
# 2. Fill in your Google OAuth Client ID
# 3. Update API URLs if needed
# 4. Adjust feature toggles as desired
# ============================================